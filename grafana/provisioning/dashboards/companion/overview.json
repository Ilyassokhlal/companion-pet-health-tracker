    {
      "type": "table",
      "title": "Came back, by signup week (last 12 weeks)",
      "description": "Accounts grouped by the week they signed up. Week 1 is the share that used the app again 7 to 13 days after signing up, Week 2 from day 14 to 20, and so on. Empty until the accounts are old enough. This table always covers the last 12 weeks, whatever the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH cohort AS (\n  SELECT id, (created_at AT TIME ZONE 'UTC')::date AS signed_up\n  FROM stats.users WHERE created_at AT TIME ZONE 'UTC' >= date_trunc('week', now()) - interval '11 weeks'\n), grid AS (\n  SELECT date_trunc('week', c.signed_up)::date AS week, n.n,\n         count(*) FILTER (WHERE current_date - c.signed_up >= 7 * n.n) AS reached,\n         count(*) FILTER (WHERE current_date - c.signed_up >= 7 * n.n AND EXISTS (\n           SELECT 1 FROM stats.activity_days a\n           WHERE a.user_id = c.id AND a.day >= c.signed_up + 7 * n.n AND a.day < c.signed_up + 7 * (n.n + 1))) AS came_back\n  FROM cohort c CROSS JOIN generate_series(1, 8) AS n (n)\n  GROUP BY 1, 2\n)\nSELECT to_char(week, 'DD Mon YYYY') AS \"Week of\",\n       (SELECT count(*) FROM cohort c WHERE date_trunc('week', c.signed_up)::date = g.week) AS \"Signups\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 1) / NULLIF(sum(reached) FILTER (WHERE n = 1), 0)) AS \"Week 1\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 2) / NULLIF(sum(reached) FILTER (WHERE n = 2), 0)) AS \"Week 2\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 3) / NULLIF(sum(reached) FILTER (WHERE n = 3), 0)) AS \"Week 3\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 4) / NULLIF(sum(reached) FILTER (WHERE n = 4), 0)) AS \"Week 4\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 5) / NULLIF(sum(reached) FILTER (WHERE n = 5), 0)) AS \"Week 5\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 6) / NULLIF(sum(reached) FILTER (WHERE n = 6), 0)) AS \"Week 6\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 7) / NULLIF(sum(reached) FILTER (WHERE n = 7), 0)) AS \"Week 7\",\n       round(100.0 * sum(came_back) FILTER (WHERE n = 8) / NULLIF(sum(reached) FILTER (WHERE n = 8), 0)) AS \"Week 8\"\nFROM grid g GROUP BY week ORDER BY week DESC"
        }
      ],
