    {
      "type": "bargauge",
      "title": "Plans",
      "description": "Where every account stands right now. Locked means the trial ended without premium.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT plan AS \"Plan\", users AS \"Users\" FROM (VALUES\n  (1, 'Trial', (SELECT count(*) FROM stats.users WHERE plan = 'trial')),\n  (2, 'Premium', (SELECT count(*) FROM stats.users WHERE plan = 'premium')),\n  (3, 'Granted', (SELECT count(*) FROM stats.users WHERE plan = 'granted')),\n  (4, 'Locked', (SELECT count(*) FROM stats.users WHERE plan = 'locked')),\n  (5, 'Banned', (SELECT count(*) FROM stats.users WHERE plan = 'banned'))\n) AS plans (pos, plan, users) ORDER BY pos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
