    {
      "type": "stat",
      "title": "New accounts",
      "description": "Signups in the last 7 days, and how that compares with the 7 days before. Empty when nobody signed up the week before.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE created_at >= (now() AT TIME ZONE 'UTC') - interval '7 days') AS \"Last 7 days\",\n       round(100.0 * (count(*) FILTER (WHERE created_at >= (now() AT TIME ZONE 'UTC') - interval '7 days')\n                      - count(*) FILTER (WHERE created_at >= (now() AT TIME ZONE 'UTC') - interval '14 days' AND created_at < (now() AT TIME ZONE 'UTC') - interval '7 days'))\n             / NULLIF(count(*) FILTER (WHERE created_at >= (now() AT TIME ZONE 'UTC') - interval '14 days' AND created_at < (now() AT TIME ZONE 'UTC') - interval '7 days'), 0)) AS \"Change from the week before\"\nFROM stats.users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Change from the week before"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "noValue",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 5,
