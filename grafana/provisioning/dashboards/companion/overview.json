          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH signups AS (\n  SELECT id, created_at FROM stats.users WHERE $__timeFilter(created_at)\n), done AS (\n  SELECT o.step, o.done_at - s.created_at AS took\n  FROM stats.onboarding_steps o JOIN signups s ON s.id = o.user_id\n)\nSELECT steps.label AS \"Step\",\n       count(done.step) AS \"Done\",\n       round(100.0 * count(done.step) / NULLIF((SELECT count(*) FROM signups), 0)) AS \"Share of signups\",\n       round(100.0 * count(done.step) FILTER (WHERE done.took < interval '7 days') / NULLIF((SELECT count(*) FROM signups), 0)) AS \"Within 7 days\",\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM done.took)) AS \"Typical time to do it\"\nFROM (VALUES (1, 'pet', 'Add your pet'), (2, 'record', 'Add a health record'), (3, 'photo', 'Attach a photo to a record'), (4, 'question', 'Ask Companion a question'), (5, 'appointment', 'Schedule an appointment'), (6, 'tracking', 'Meet the trackers')) AS steps (pos, step, label)\nLEFT JOIN done ON done.step = steps.step\nGROUP BY steps.pos, steps.label ORDER BY steps.pos"
        }
