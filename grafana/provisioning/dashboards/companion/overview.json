    {
      "type": "timeseries",
      "title": "Signups per day",
      "description": "New accounts per day in your timezone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at AT TIME ZONE 'UTC') AS time, count(*) AS \"Signups\"\nFROM stats.users WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
