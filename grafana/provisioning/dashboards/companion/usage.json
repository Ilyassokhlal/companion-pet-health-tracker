          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE NOT answered) / NULLIF(count(*), 0), 1) AS \"Refused\" FROM stats.questions WHERE $__timeFilter(created_at)"
