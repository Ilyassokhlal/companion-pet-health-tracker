    {
      "type": "timeseries",
      "title": "Questions per day",
      "description": "Questions each day in your timezone, answered and refused.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at AT TIME ZONE 'UTC') AS time,\n       count(*) FILTER (WHERE answered) AS \"Answered\",\n       count(*) FILTER (WHERE NOT answered) AS \"Refused\"\nFROM stats.questions WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
