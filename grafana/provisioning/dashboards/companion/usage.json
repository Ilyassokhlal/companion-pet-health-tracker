    {
      "type": "timeseries",
      "title": "Logged per day",
      "description": "Records, photos, walks and feedings added each day. Things deleted since are not counted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, metric, count(*) AS value FROM (\n  SELECT date_trunc('day', created_at AT TIME ZONE 'UTC') AS time, 'Records' AS metric FROM stats.records WHERE $__timeFilter(created_at)\n  UNION ALL\n  SELECT date_trunc('day', created_at AT TIME ZONE 'UTC'), 'Photos' FROM stats.photos WHERE $__timeFilter(created_at)\n  UNION ALL\n  SELECT date_trunc('day', created_at AT TIME ZONE 'UTC'), 'Walks' FROM stats.walks WHERE $__timeFilter(created_at)\n  UNION ALL\n  SELECT date_trunc('day', created_at AT TIME ZONE 'UTC'), 'Feedings' FROM stats.feedings WHERE $__timeFilter(created_at)\n) AS logged\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
