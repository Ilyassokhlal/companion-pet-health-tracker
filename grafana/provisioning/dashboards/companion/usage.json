    {
      "type": "table",
      "title": "Most active accounts",
      "description": "The 10 accounts that used the app on the most days in the time range. Click an email for its detail in Users.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "companion"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "companion"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT u.id, u.email AS \"Email\", t.questions AS \"Questions\", t.records AS \"Records\", t.photos AS \"Photos\",\n       t.walks AS \"Walks\", t.feedings AS \"Feedings\", t.active_days AS \"Active days\"\nFROM stats.users u\nCROSS JOIN LATERAL (\n  SELECT (SELECT count(*) FROM stats.questions q WHERE q.user_id = u.id AND $__timeFilter(q.created_at)) AS questions,\n         (SELECT count(*) FROM stats.records r WHERE r.user_id = u.id AND $__timeFilter(r.created_at)) AS records,\n         (SELECT count(*) FROM stats.photos p WHERE p.user_id = u.id AND $__timeFilter(p.created_at)) AS photos,\n         (SELECT count(*) FROM stats.walks w WHERE w.user_id = u.id AND $__timeFilter(w.created_at)) AS walks,\n         (SELECT count(*) FROM stats.feedings f WHERE f.user_id = u.id AND $__timeFilter(f.created_at)) AS feedings,\n         (SELECT count(*) FROM stats.activity_days a WHERE a.user_id = u.id AND a.day BETWEEN ($__timeFrom()::timestamptz)::date AND ($__timeTo()::timestamptz)::date) AS active_days\n) AS t\nWHERE t.active_days > 0\nORDER BY t.active_days DESC, t.questions + t.records + t.photos + t.walks + t.feedings DESC\nLIMIT 10"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "decimals": null
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Email"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 230
              },
              {
