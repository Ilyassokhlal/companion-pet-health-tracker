# --- Security ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
POSTGRES_USER=companion
POSTGRES_PASSWORD=
POSTGRES_DB=companion
DATABASE_URL=postgresql+psycopg://companion:CHANGEME@db:5432/companion

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL_NAME=claude-haiku-4-5

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Companion <noreply@yourdomain>

# Optional. Defaults to FRONTEND_URL/icon.png, which no mail client can fetch
# while FRONTEND_URL is localhost.
EMAIL_LOGO_URL=

# --- ChromaDB ---
CHROMA_PATH=/data/chroma
COLLECTION_NAME=documents

# --- RAG ---
MAX_RESULTS=5
CONFIDENCE_THRESHOLD=0.91
DOCS_DIRECTORY=./docs

# --- Photos ---
PHOTO_DIR=/data/photos
MAX_PHOTO_MB=20

# --- Reminders ---
REMINDER_HOUR=6
REMINDER_LEAD_DAYS=7
TIMEZONE=UTC

# --- App ---
DEBUG=false
FRONTEND_URL=http://localhost:5173

# The containerised frontend on :80 and the Vite dev server on :5173 are different origins.
# Both are needed to develop against the stack.
CORS_ORIGINS=http://localhost,http://localhost:5173

# VITE_API_URL is a build ARG for the frontend image, not a runtime variable.
# /api is correct both in production and for the containerised frontend locally, since Caddy proxies /api in both.
# Compose also falls back to /api when this is empty. The Vite dev server reads its own frontend-web/.env.
VITE_API_URL=/api

# --- Premium (RevenueCat) ---
# Secret API key from RevenueCat's project settings. Server side only, never put it in an app.
REVENUECAT_SECRET_KEY=
# The exact Authorization header value set on the webhook in RevenueCat, for example "Bearer " followed by a long random string. Empty rejects every webhook call.
REVENUECAT_WEBHOOK_AUTH=
# The entitlement identifier created in RevenueCat.
REVENUECAT_ENTITLEMENT=premium
# RevenueCat's public API key for its Stripe app (shown when Stripe is connected in RevenueCat).
REVENUECAT_STRIPE_PUBLIC_KEY=

# --- Payments on the web (Stripe) ---
# Use test mode keys and prices until launch.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Signing secret of the Stripe webhook endpoint for /api/billing/stripe.
STRIPE_WEBHOOK_SECRET=

# --- Deployment (production only) ---
# The domain Caddy serves. Unset means :80 over plain HTTP, so this is the single line that switches production to automatic TLS.
SITE_ADDRESS=