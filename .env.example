# --- Security ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
POSTGRES_USER=companion
POSTGRES_PASSWORD=
POSTGRES_DB=companion
DATABASE_URL=postgresql+psycopg://companion:CHANGEME@db:5432/companion

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL_NAME=claude-haiku-4-5

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Companion <noreply@yourdomain>

# Optional. Defaults to FRONTEND_URL/icon.png, which no mail client can fetch
# while FRONTEND_URL is localhost.
EMAIL_LOGO_URL=

# --- ChromaDB ---
CHROMA_PATH=/data/chroma
COLLECTION_NAME=documents

# --- RAG ---
MAX_RESULTS=5
CONFIDENCE_THRESHOLD=1.2
DOCS_DIRECTORY=./docs

# --- Photos ---
PHOTO_DIR=/data/photos
MAX_PHOTO_MB=5

# --- Reminders ---
REMINDER_HOUR=8
REMINDER_LEAD_DAYS=7
TIMEZONE=UTC

# --- App ---
DEBUG=false
FRONTEND_URL=http://localhost:5173

# The containerised frontend on :80 and the Vite dev server on :5173 are different origins.
# Both are needed to develop against the stack.
CORS_ORIGINS=http://localhost,http://localhost:5173

# VITE_API_URL is a build ARG for the frontend image, not a runtime variable.
# Compose defaults it to /api, which is correct both in production and for the containerised frontend locally, since Caddy
# proxies /api in both. No need to set it here.
# The Vite dev server reads its own frontend-web/.env.

# --- Deployment (production only) ---
# The domain Caddy serves. Unset means :80 over plain HTTP, so this is the single line that switches production to automatic TLS.
SITE_ADDRESS=mycompanion.pet